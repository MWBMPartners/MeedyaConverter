<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>MeedyaConverter</string>
    <key>CFBundleIconFile</key>
    <!-- Filename (without extension) of the .icns in Contents/Resources/.
         scripts/generate-app-icns.sh assembles MeedyaConverter.icns from
         the AppIcon.appiconset PNG sources; the release.yml + testflight.yml
         workflows copy it into the bundle's Resources/ directory before
         signing. Without this key the App Store Connect validator rejects
         the build with ITMS-90236 (#390). -->
    <string>MeedyaConverter</string>
    <key>CFBundleIdentifier</key>
    <!-- Direct distribution bundle ID. CI substitutes Ltd.MWBMpartners.MeedyaConverter.Lite for App Store builds. -->
    <string>Ltd.MWBMpartners.MeedyaConverter</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>MeedyaConverter</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- AppleScript / JXA scriptability (#302). NSAppleScriptEnabled makes the
         app respond to Apple Events; OSAScriptingDefinition names the .sdef
         (staged at Contents/Resources/MeedyaConverter.sdef by the app-packaging
         step in release.yml / dev-build.yml) that maps the scripting verbs to
         the NSScriptCommand subclasses in ScriptingCommands.swift, which
         dispatch to ScriptingBridge.shared (wired to the live engine/queue in
         AppViewModel.init). -->
    <key>NSAppleScriptEnabled</key>
    <true/>
    <key>OSAScriptingDefinition</key>
    <string>MeedyaConverter.sdef</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <!-- Custom URL scheme so the OS delivers meedyaconverter://profile/<base64url>
         share links to the app; MeedyaConverterApp's .onOpenURL imports the
         encoded EncodingProfile via ProfileSharing.importFromShareLink (#491).
         Without this registration Launch Services never routes the URL and the
         handler can never fire. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>Ltd.MWBMpartners.MeedyaConverter.profile</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>meedyaconverter</string>
            </array>
        </dict>
    </array>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 MWBM Partners Ltd. All rights reserved.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.video</string>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <key>NSSupportsSuddenTermination</key>
    <false/>
</dict>
</plist>
